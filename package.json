{
  "name": "saucedemo-wdio-e2e",
  "version": "1.0.0",
  "description": "End-to-end WebdriverIO tests for SauceDemo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:checkout": "wdio run ./wdio.conf.js --suite checkout",
    "test:login": "wdio run ./wdio.conf.js --suite login",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "clean": "rimraf allure-results allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.15.0",
    "@wdio/cli": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "allure-commandline": "^2.34.1",
    "rimraf": "^6.0.1",
    "webdriverio": "^9.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
